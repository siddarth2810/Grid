{
  "manifest_version": 3,
  "name": "Plumb — Layout Grid & Spacing",
  "version": "1.0.0",
  "description": "Drop guide lines on any website to check its layout grid, alignment and spacing in pixels.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plumb",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Show / hide grid lines"
    },
    "toggle-draw": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Start / stop drawing lines"
    }
  }
}
